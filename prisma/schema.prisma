generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  PRODUCTION
  STOCK
  DISPATCH
  CLIENT
}

enum ClientType {
  STORE
  EXTERNAL
}

enum StorageType {
  AMBIENT
  REFRIGERATED
  FROZEN
}

enum UnitType {
  UNIT
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PACKAGE
}

enum OrderStatus {
  REQUESTED
  APPROVED
  IN_PRODUCTION
  SEPARATED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum MovementType {
  ENTRY
  PRODUCTION
  SHIPMENT
  TRANSFER
  ADJUSTMENT
  LOSS
  RETURN
}

enum LossReason {
  EXPIRED
  PRODUCTION_ERROR
  QUALITY
  STORAGE
  DAMAGE
  LEFTOVER
  STOCK_DIFFERENCE
  OTHER
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String?
  role         UserRole          @default(PRODUCTION)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  orders       ProductionOrder[] @relation("OrderCreator")
  batches      Batch[]           @relation("BatchCreator")
  movements    StockMovement[]   @relation("MovementCreator")
  labels       LabelPrint[]       @relation("LabelPrinter")
  losses       Loss[]            @relation("LossReporter")
  auditLogs    AuditLog[]
}

model Client {
  id          String            @id @default(cuid())
  name        String
  code        String            @unique
  type        ClientType        @default(STORE)
  document    String?
  contactName String?
  phone       String?
  email       String?
  city        String
  state       String            @default("BA")
  address     String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  orders      ProductionOrder[]
  batches     Batch[]

  @@index([active, name])
}

model Product {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  category       String
  unit           UnitType         @default(KILOGRAM)
  shelfLifeDays  Int
  storage        StorageType
  storageMinC    Decimal?         @db.Decimal(5, 2)
  storageMaxC    Decimal?         @db.Decimal(5, 2)
  defaultWeightG Int?
  minStock       Decimal          @default(0) @db.Decimal(12, 3)
  allergens      String[]         @default([])
  instructions   String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          ProductionItem[]
  batches        Batch[]
  movements      StockMovement[]
  losses         Loss[]

  @@index([category, active])
  @@index([name])
}

model ProductionOrder {
  id           String           @id @default(cuid())
  code         String           @unique
  clientId     String
  createdById  String
  requestedFor DateTime
  priority     Int              @default(2)
  status       OrderStatus      @default(REQUESTED)
  notes        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  client       Client           @relation(fields: [clientId], references: [id])
  createdBy    User             @relation("OrderCreator", fields: [createdById], references: [id])
  items        ProductionItem[]

  @@index([status, requestedFor])
  @@index([clientId, requestedFor])
}

model ProductionItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  plannedQuantity Decimal         @db.Decimal(12, 3)
  producedQuantity Decimal        @default(0) @db.Decimal(12, 3)
  packagesPlanned Int?
  packageWeightG  Int?
  notes           String?
  order           ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  batches         Batch[]

  @@unique([orderId, productId])
}

model Batch {
  id               String           @id @default(cuid())
  code             String           @unique
  productId        String
  productionItemId String?
  clientId         String?
  createdById      String
  producedAt       DateTime
  expiresAt        DateTime
  quantity         Decimal          @db.Decimal(12, 3)
  availableQuantity Decimal         @db.Decimal(12, 3)
  unit             UnitType
  blocked          Boolean          @default(false)
  blockReason      String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  product          Product           @relation(fields: [productId], references: [id])
  productionItem   ProductionItem?   @relation(fields: [productionItemId], references: [id])
  client           Client?           @relation(fields: [clientId], references: [id])
  createdBy        User              @relation("BatchCreator", fields: [createdById], references: [id])
  movements        StockMovement[]
  labels           LabelPrint[]
  losses           Loss[]

  @@index([expiresAt, blocked])
  @@index([productId, availableQuantity])
  @@index([clientId, producedAt])
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  batchId     String?
  type        MovementType
  quantity    Decimal      @db.Decimal(12, 3)
  unit        UnitType
  source      String?
  destination String?
  reason      String?
  createdById String
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id])
  batch       Batch?       @relation(fields: [batchId], references: [id])
  createdBy   User         @relation("MovementCreator", fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([batchId, createdAt])
}

model LabelPrint {
  id          String   @id @default(cuid())
  batchId     String
  copies      Int      @default(1)
  template    String   @default("60x40")
  printerName String?
  printedById String
  printedAt   DateTime @default(now())
  batch       Batch    @relation(fields: [batchId], references: [id])
  printedBy   User     @relation("LabelPrinter", fields: [printedById], references: [id])

  @@index([batchId, printedAt])
}

model Loss {
  id           String     @id @default(cuid())
  productId    String
  batchId      String?
  quantity     Decimal    @db.Decimal(12, 3)
  unit         UnitType
  reason       LossReason
  notes        String?
  photoUrl     String?
  reportedById String
  createdAt    DateTime   @default(now())
  product      Product    @relation(fields: [productId], references: [id])
  batch        Batch?     @relation(fields: [batchId], references: [id])
  reportedBy   User       @relation("LossReporter", fields: [reportedById], references: [id])

  @@index([reason, createdAt])
  @@index([productId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}
